# Gardena / Husqvarna developer portal application credentials.
GARDENA_APPLICATION_KEY=
GARDENA_APPLICATION_SECRET=

# Optional: Husqvarna account login. Only used to force the soil sensor to take
# a reading before a moisture-gated run — the public API has no command for it.
# Leave blank and an out-of-date reading is simply treated as unknown (waters).
GARDENA_EMAIL=
GARDENA_PASSWORD=

# Where the SQLite database lives. Must be on a persistent volume in production.
DATABASE_PATH=./data/gardena.db
